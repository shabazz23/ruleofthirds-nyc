# Rule of Thirds store — environment variables.
#
# Copy this file to `.env.local` for local development. In production, set
# these in Vercel → Project → Settings → Environment Variables (see
# SETUP.md for where each value comes from).
#
# NEVER commit real values. This file lists names only (plus public URLs).

# --- Auth (Auth.js) ---
# Random secret, 32+ characters. Generate one with: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the site. Optional: the auth config trusts the host from
# the request, so this is only needed if the site is deployed somewhere
# that doesn't set forwarded-host headers correctly.
# AUTH_URL=https://ruleofthirds.nyc

# --- Database (Vercel Postgres) ---
# Auto-provided by Vercel when the Postgres database is created and linked
# to the project. No manual value needed — it appears on its own.
POSTGRES_URL=

# --- Stripe ---
# Dashboard → Developers → API keys → Secret key (live, starts with sk_live_).
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → the endpoint's Signing secret
# (starts with whsec_).
STRIPE_WEBHOOK_SECRET=

# --- PayPal (live) ---
# PayPal Developer Dashboard → Apps & Credentials → Live → "Rule of Thirds" app.
# The Client ID is public — it ships in the checkout page's JS SDK tag.
# The Secret stays server-side and must never be shared or committed.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Google sign-in (optional) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Leave both unset to offer email/password sign-in only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Site URL (optional) ---
# Used for the Stripe success/cancel redirect URLs. Defaults to
# https://ruleofthirds.nyc when unset.
SITE_URL=https://ruleofthirds.nyc
